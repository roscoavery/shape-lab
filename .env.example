# Production gym data (Vercel). Required so roster / library / feed survive
# function restarts. Create a Blob store in the Vercel project, then paste:
BLOB_READ_WRITE_TOKEN=

# Optional named Cloudflare tunnel if you still run the gym PC locally.
# Copy this file to .env (gitignored). See README → “Gym computer (local)”.

# Token from Cloudflare → Networking → Tunnels → shape-lab
CLOUDFLARE_TUNNEL_TOKEN=

# Public URL you attached as a published application (for the console reminder)
CLOUDFLARE_TUNNEL_HOSTNAME=https://gym.example.com

# Optional: full path to the cloudflared binary if it is not on PATH
# CLOUDFLARED_BIN=
