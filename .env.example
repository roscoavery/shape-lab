# Copy this file to .env (gitignored). See README → “Move the gym onto the home computer”.

# Needed only for `npm run gym:pull` — copy from Vercel → Storage → Blob
# while Production is still up. `npm run gym` strips this so the home PC
# writes data/ on disk and does not keep billing Blob.
BLOB_READ_WRITE_TOKEN=

# Set automatically by `npm run gym`. Forces disk persist even if a Blob
# token is still in the environment.
# GYM_HOME=1

# Optional named Cloudflare tunnel if you run the gym PC locally.

# Token from Cloudflare Zero Trust → Networks → Tunnels → shape-lab
# Copy the install token (one long line starting with eyJ). Do not paste
# the words "paste the token".
CLOUDFLARE_TUNNEL_TOKEN=

# Public URL you attached as a published application (for the console reminder)
CLOUDFLARE_TUNNEL_HOSTNAME=https://gym.shapelab.win

# Optional: full path to the cloudflared binary if it is not on PATH
# CLOUDFLARED_BIN=

# --- Shape Lab V4 authentication (server only — never VITE_ prefix) ---
# First admin when no accounts exist yet. Use a long unique password.
SHAPE_LAB_BOOTSTRAP_ADMIN_EMAIL=you@example.com
SHAPE_LAB_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-password

# Optional: email one-time sign-in links. Copy-link still works if these are empty.
# Never use a VITE_ prefix. Do not commit this file.
SHAPE_LAB_MAIL_FROM=
SHAPE_LAB_SMTP_HOST=
SHAPE_LAB_SMTP_PORT=587
SHAPE_LAB_SMTP_USER=
SHAPE_LAB_SMTP_PASS=
# SHAPE_LAB_SMTP_SECURE=1

# Allow the first-run "create admin" form on the gym computer.
# The gym script (GYM_HOME=1) already allows this. Set 1 on a trusted local preview.
# SHAPE_LAB_ALLOW_FIRST_ADMIN=1
