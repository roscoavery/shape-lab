{
  "name": "shape-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43127",
    "start": "node scripts/gym-home.mjs",
    "build": "tsc -b && vite build",
    "build:api": "node scripts/bundle-api.mjs",
    "lint": "oxlint",
    "test:v4-security": "node --experimental-strip-types scripts/v4-security-check.mjs",
    "test:v4-family": "node --experimental-strip-types scripts/v4-family-check.mjs",
    "test:v4-skill-goal": "node --experimental-strip-types scripts/v4-skill-goal-check.mjs",
    "test:v4-desk": "node --experimental-strip-types scripts/v4-desk-check.mjs",
    "preview": "vite preview --host --port 43127",
    "share": "node scripts/share.mjs",
    "share:quick": "node scripts/share.mjs --quick",
    "gym": "node scripts/gym-home.mjs",
    "gym:dev": "GYM_DEV=1 node scripts/gym-home.mjs",
    "gym:pull": "node scripts/pull-from-blob.mjs",
    "gym:up": "node scripts/gym-up.mjs",
    "gym:mac": "bash scripts/mac-gym.sh",
    "gym:recover": "bash scripts/recover-gym-v4.sh",
    "gym:boot": "bash scripts/boot-lace.sh",
    "gym:lace": "bash scripts/mac-gym.sh",
    "gym:mac:v4": "GYM_BRANCH=shape-lab-v4 bash scripts/mac-gym.sh",
    "gym:token": "node scripts/set-tunnel-token.mjs",
    "gym:photos": "node scripts/restore-photos-from-backup.mjs",
    "gym:shapes": "node scripts/delete-gym-shape.mjs",
    "gym:stills": "node scripts/restore-stills-from-blobs.mjs",
    "test:calendar": "tsx --test server/calendar/*.test.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vercel/blob": "^2.8.0",
    "nodemailer": "^10.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdav": "^2.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
